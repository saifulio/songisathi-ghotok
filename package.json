{
  "name": "songisathi-ghotok",
  "version": "1.0.0",
  "description": "SongiSathi — family-mediated matchmaking platform (React)",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed.mjs",
    "db:reset": "node db/migrate.mjs --drop && node db/seed.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "vite": "^5.4.11"
  },
  "keywords": []
}
